# GymOS — copy to .env. Never commit .env.
# Host ports are shifted to avoid clashing with a local Homebrew install (D-006).

NODE_ENV=development
LOG_LEVEL=info

# API
PORT=3000
WEB_ORIGIN=http://localhost:3001

# Datastores — note ports 5433 / 6380, matching docker-compose.yml
DATABASE_URL=postgres://gymos:gymos@localhost:5433/gymos
REDIS_URL=redis://127.0.0.1:6380

# The application role. Must be NOBYPASSRLS — never the table owner (D-004).
# Migrations run as the owner above; the API connects as this role.
DATABASE_APP_URL=postgres://gymos_app:gymos_app@localhost:5433/gymos

# Sessions
SESSION_SECRET=dev-only-change-me-0123456789abcdef
SESSION_TTL_DAYS=30

# Org defaults (overridable per organization in the DB)
DEFAULT_TIMEZONE=Asia/Tehran
ARREARS_GRACE_RIAL=500000
DISCOUNT_MAX_PCT=20
WRITEOFF_MAX_RIAL=5000000

# Seed
SEED_ORG_NAME=باشگاه آتلانتیک
SEED_MEMBER_COUNT=600
