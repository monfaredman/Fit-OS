{
  "name": "@gymos/kiosk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first check-in terminal. Deliberately not a Next.js route.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --port 3002",
    "preview": "vite preview --port 3002",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
  }
}
